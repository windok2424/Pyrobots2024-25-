    public void zpb(int targetPosition) {
        // Set target position and mode
        slide = hardwareMap.get(DcMotorEx.class, "rem");
        slide.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        boolean hitpos = false;
        while(opModeIsActive()) {
            int slidpos = slide.getCurrentPosition();

            // Set motor power
            if (slidpos > targetPosition) {
                slide.setPower(0.5);

            }
            if (slidpos < targetPosition) {
                slide.setPower(-0.5);

            }
            if(slidpos <= targetPosition + 25 && slidpos >= targetPosition-25){
                slide.setPower(0);
                hitpos = true;
            }



            telemetry.addData("Slide Target", targetPosition);
            telemetry.addData("Slide Current", slide.getCurrentPosition());
            telemetry.update();
