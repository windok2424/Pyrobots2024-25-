    public void oop(int slid, double last){
        Servo italy = hardwareMap.servo.get("outClaw");
        ElapsedTime sec = new ElapsedTime();
        sec.reset();

        while(opModeIsActive()) {

            double current = sec.seconds();
            if (slid == 0) {
                slide.setPower(0);
            }
            if (slid == 1) {
                slide.setPower(0.9);
                italy.setPosition(0);
            }
            if (slid == 2) {

                slide.setPower(-0.9);
            }

            if(last < current){
                sleep(100);
                italy.setPosition(0.9);
                sleep(300);
                slide.setPower(-0.8);
                double new_last = last *1000;


                sleep((long) new_last);
                slide.setPower(0);
                break;
            }

        }
    }
    public void Turn(double rgo, double last){
        ElapsedTime sec = new ElapsedTime();
        sec.reset();
        double current = sec.seconds();
        while(opModeIsActive()){
            current = sec.seconds();
            double RPos = getAngle();
            double pow = DriveFunctions.ryan(RPos, rgo);

            FL.setPower(pow);
            FR.setPower(pow);
            BL.setPower(pow);
            BR.setPower(pow);
            if(last <= current){

                break;
            }

        }



    }
